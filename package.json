{
  "name": "cua-constraint-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 tests/integration/browser.test.ts",
    "format": "prettier --write src scripts tests config package.json tsconfig.json README.md docs .github/workflows/ci.yml",
    "format:check": "prettier --check src scripts tests config package.json tsconfig.json README.md docs .github/workflows/ci.yml",
    "openapps:doctor": "node --import tsx scripts/openapps.ts doctor",
    "openapps:smoke": "node --import tsx scripts/openapps.ts smoke",
    "poc:run": "node --import tsx scripts/openapps.ts run",
    "pilot:run": "node --import tsx scripts/openapps.ts pilot",
    "main:freeze": "node --import tsx scripts/openapps.ts main-freeze"
  },
  "dependencies": {
    "playwright": "^1.58.0",
    "yaml": "^2.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "3.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
