{
  "name": "cua-constraint-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "format": "prettier --write src scripts tests config package.json tsconfig.json README.md docs .github/workflows/ci.yml",
    "format:check": "prettier --check src scripts tests config package.json tsconfig.json README.md docs .github/workflows/ci.yml",
    "webarena": "node --import tsx scripts/webarena.ts",
    "webarena:doctor": "node --import tsx scripts/webarena.ts doctor",
    "webarena:validate": "node --import tsx scripts/webarena.ts validate",
    "webarena:prepare": "node --import tsx scripts/webarena.ts prepare",
    "webarena:inspect": "node --import tsx scripts/webarena.ts inspect",
    "webarena:evaluate": "node --import tsx scripts/webarena.ts evaluate"
  },
  "dependencies": {
    "playwright": "^1.58.0",
    "yaml": "^2.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "3.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
