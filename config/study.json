{
  "schema_version": 2,
  "benchmark": {
    "name": "WebArena-Verified",
    "pypi_version": "1.2.3",
    "site": "shopping",
    "dataset_tag": "v1.2.3"
  },
  "scope": {
    "poc_task_count": 3,
    "poc_task_ids": [279, 284, 528],
    "pilot_task_count": 6,
    "main_task_count": 32,
    "model_count": 4,
    "methods": ["Baseline", "Proposed"]
  },
  "suitability": {
    "min_required_constraints": 3,
    "min_information_choices": 2
  },
  "pilot_gate": {
    "min_valid_run_fraction": 0.95,
    "min_official_successes": 10,
    "min_successful_models": 2,
    "min_successful_tasks": 2,
    "caveat": "Preregistered provisional operational threshold only. Must be approved by supervisor BEFORE pilot; evaluate model/task floor effects and technical errors. Do not change after outcomes, and no provisional pass alone authorizes main."
  },
  "execution": {
    "max_steps": 16,
    "temperature": 0,
    "max_decision_screenshots": 3,
    "require_site_reset_between_episodes": true
  },
  "metrics": {
    "primary": "official_task_success",
    "secondary": [
      "evidence_correctness_human_audited",
      "constraint_coverage_human_audited",
      "browser_actions",
      "probes",
      "model_calls",
      "duration_ms",
      "invalid_output_rate"
    ],
    "diagnostic": ["first_decision_divergence", "constraint_state_trace"],
    "paired_unit": "task_id + model_label"
  }
}
